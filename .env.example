# Copy to .env (which git ignores) to switch on write actions such as
# POST /api/v1/ingest. Without these, nxcat is read-only and writes answer 503.
#
# Fill in the two secrets with these commands (run from the repository root on
# macOS; on Linux use `sed -i` instead of `sed -i ''`). They write straight into
# .env, so the secrets never appear on screen:
#
#   cp .env.example .env
#   KEY=$(python3 -c "import secrets; print(secrets.token_urlsafe(48))")
#   sed -i '' "s|^NXCAT_SECRET_KEY=.*|NXCAT_SECRET_KEY=$KEY|" .env
#   HASH=$(cd backend && uv run nxcat-hash-password)      # asks for a password (12+ chars)
#   sed -i '' "s|^NXCAT_ADMIN_PASSWORD_HASH=.*|NXCAT_ADMIN_PASSWORD_HASH='$HASH'|" .env
#   docker compose up -d --wait                            # restart so the API reads .env
#
# Keep the single quotes around the hash: it contains "$" signs, which Docker
# Compose would otherwise treat as variables and silently remove.
# Never commit .env, and never paste its values into chats or issues.

NXCAT_SECRET_KEY=
NXCAT_ADMIN_USERNAME=admin
NXCAT_ADMIN_PASSWORD_HASH=''
NXCAT_TOKEN_MINUTES=30

# --- Plain-English search (optional) ---------------------------------------
# Any model LiteLLM supports. For a free local model with Ollama on your Mac:
#   ollama pull qwen2.5:7b-instruct
# then set the two lines below. Leave NXCAT_LLM_MODEL empty to switch it off.
NXCAT_LLM_MODEL=
NXCAT_LLM_API_BASE=http://host.docker.internal:11434
