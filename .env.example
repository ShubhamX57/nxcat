# Copy to .env (which git ignores) and fill in, to switch on write actions such as
# POST /api/v1/ingest. Without these, nxcat is read-only and writes answer 503.
#
#   cp .env.example .env
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   -> NXCAT_SECRET_KEY
#   docker compose run --rm api nxcat-hash-password                  -> NXCAT_ADMIN_PASSWORD_HASH
#
# Never commit .env. The values here are placeholders, not working secrets.

NXCAT_SECRET_KEY=
NXCAT_ADMIN_USERNAME=admin
NXCAT_ADMIN_PASSWORD_HASH=
NXCAT_TOKEN_MINUTES=30
